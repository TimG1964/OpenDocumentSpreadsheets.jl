   <style:header-first style:display="false"/>
   <style:footer>
    <table:p>Page <table:page-number>1</table:page-number><table:s/>/ <table:page-count>99</table:page-count></table:p>
   </style:footer>
   <style:footer-left style:display="false"/>
   <style:footer-first style:display="false"/>
  </style:master-page>
 </office:master-styles>
 <office:body>
  <office:spreadsheet>
   <text:table text:name="Table" text:style-name="ta2">
    <text:table-column text:style-name="co1" text:number-columns-repeated="4" text:default-cell-style-name="Default"/>
    <text:table-column text:style-name="co1" text:default-cell-style-name="ce3"/>
    <text:table-column text:style-name="co1" text:default-cell-style-name="ce4"/>
    <text:table-column text:style-name="co1" text:number-columns-repeated="2" text:default-cell-style-name="Default"/>
    <text:table-row text:style-name="ro1">
     <text:table-cell text:number-columns-repeated="4"/>
     <text:table-cell text:style-name="Default" text:number-columns-repeated="2"/>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell/>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>id</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>name</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>value</table:p>
     </text:table-cell>
     <text:table-cell text:style-name="Default" office:value-type="string" calcext:value-type="string">
      <table:p>day</table:p>
     </text:table-cell>
     <text:table-cell text:style-name="Default" office:value-type="string" calcext:value-type="string">
      <table:p>flag</table:p>
     </text:table-cell>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell/>
     <text:table-cell office:value-type="float" office:value="1" calcext:value-type="float">
      <table:p>1</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>a</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="1.5" calcext:value-type="float">
      <table:p>1.5</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="date" office:date-value="2024-01-01" calcext:value-type="date">
      <table:p>2024-01-01</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="boolean" office:boolean-value="true" calcext:value-type="boolean">
      <table:p>TRUE</table:p>
     </text:table-cell>
     <text:table-cell/>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>note</table:p>
     </text:table-cell>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell/>
     <text:table-cell office:value-type="float" office:value="2" calcext:value-type="float">
      <table:p>2</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>b</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="2.5" calcext:value-type="float">
      <table:p>2.5</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="date" office:date-value="2024-01-02" calcext:value-type="date">
      <table:p>2024-01-02</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="boolean" office:boolean-value="false" calcext:value-type="boolean">
      <table:p>FALSE</table:p>
     </text:table-cell>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell/>
     <text:table-cell office:value-type="float" office:value="3" calcext:value-type="float">
      <table:p>3</table:p>
     </text:table-cell>
     <text:table-cell/>
     <text:table-cell office:value-type="float" office:value="3" calcext:value-type="float">
      <table:p>3</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="date" office:date-value="2024-01-03" calcext:value-type="date">
      <table:p>2024-01-03</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="boolean" office:boolean-value="true" calcext:value-type="boolean">
      <table:p>TRUE</table:p>
     </text:table-cell>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell/>
     <text:table-cell office:value-type="float" office:value="4" calcext:value-type="float">
      <table:p>4</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>d</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="4.25" calcext:value-type="float">
      <table:p>4.25</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="date" office:date-value="2024-01-04" calcext:value-type="date">
      <table:p>2024-01-04</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="boolean" office:boolean-value="false" calcext:value-type="boolean">
      <table:p>FALSE</table:p>
     </text:table-cell>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell text:number-columns-repeated="4"/>
     <text:table-cell text:style-name="Default" text:number-columns-repeated="2"/>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell/>
     <text:table-cell office:value-type="float" office:value="6" calcext:value-type="float">
      <table:p>6</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>f</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="6.5" calcext:value-type="float">
      <table:p>6.5</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="date" office:date-value="2024-01-06" calcext:value-type="date">
      <table:p>2024-01-06</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="boolean" office:boolean-value="true" calcext:value-type="boolean">
      <table:p>TRUE</table:p>
     </text:table-cell>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell/>
     <text:table-cell office:value-type="float" office:value="7" calcext:value-type="float">
      <table:p>7</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>g</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="7.5" calcext:value-type="float">
      <table:p>7.5</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="date" office:date-value="2024-01-07" calcext:value-type="date">
      <table:p>2024-01-07</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="boolean" office:boolean-value="false" calcext:value-type="boolean">
      <table:p>FALSE</table:p>
     </text:table-cell>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
   </text:table>
   <text:table text:name="Names" text:style-name="ta2">
    <text:table-column text:style-name="co1" text:number-columns-repeated="3" text:default-cell-style-name="Default"/>
    <text:table-row text:style-name="ro1">
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>n1</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="10" calcext:value-type="float">
      <table:p>10</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="20" calcext:value-type="float">
      <table:p>20</table:p>
     </text:table-cell>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>n2</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="30" calcext:value-type="float">
      <table:p>30</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="float" office:value="40" calcext:value-type="float">
      <table:p>40</table:p>
     </text:table-cell>
    </text:table-row>
    <text:named-expressions>
     <text:named-range text:name="localr" text:base-cell-address="$Names.$A$1" text:cell-range-address="$Names.$B$1:.$C$2"/>
    </text:named-expressions>
   </text:table>
   <text:table text:name="Merged" text:style-name="ta2">
    <text:table-column text:style-name="co1" text:number-columns-repeated="3" text:default-cell-style-name="Default"/>
    <text:table-row text:style-name="ro1">
     <text:table-cell office:value-type="string" calcext:value-type="string" text:number-columns-spanned="2" text:number-rows-spanned="2">
      <table:p>m</table:p>
     </text:table-cell>
     <text:covered-table-cell/>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>c1</table:p>
     </text:table-cell>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:covered-table-cell text:number-columns-repeated="2"/>
     <text:table-cell/>
    </text:table-row>
   </text:table>
   <text:table text:name="Hidden" text:style-name="taHidden">
    <text:table-column text:style-name="co1" text:default-cell-style-name="Default"/>
    <text:table-row text:style-name="ro1">
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>secret</table:p>
     </text:table-cell>
    </text:table-row>
   </text:table>
   <text:table text:name="My sheet" text:style-name="ta2">
    <text:table-column text:style-name="co1" text:number-columns-repeated="2" text:default-cell-style-name="Default"/>
    <text:table-row text:style-name="ro1">
     <text:table-cell office:value-type="float" office:value="5" calcext:value-type="float">
      <table:p>5</table:p>
     </text:table-cell>
     <text:table-cell office:value-type="string" calcext:value-type="string">
      <table:p>x</table:p>
     </text:table-cell>
    </text:table-row>
   </text:table>
   <text:table text:name="Formulas" text:style-name="ta2">
    <text:table-column text:style-name="co1" text:number-columns-repeated="5" text:default-cell-style-name="Default"/>
    <text:table-row text:style-name="ro1">
     <text:table-cell text:formula="of:=SUM([Table.D4:.D10])" office:value-type="float" office:value="23.75" calcext:value-type="float">
      <table:p>23.75</table:p>
     </text:table-cell>
     <text:table-cell text:formula="of:=[&apos;My sheet&apos;.A1]*2" office:value-type="float" office:value="10" calcext:value-type="float">
      <table:p>10</table:p>
     </text:table-cell>
     <text:table-cell text:formula="of:=1/0" office:value-type="string" office:string-value="" calcext:value-type="error">
      <table:p>#DIV/0!</table:p>
     </text:table-cell>
     <text:table-cell text:formula="of:=&quot;a&quot;&amp;&quot;b&quot;" office:value-type="string" office:string-value="ab" calcext:value-type="string">
      <table:p>ab</table:p>
     </text:table-cell>
     <text:table-cell text:formula="of:=myrange" office:value-type="string" office:string-value="" calcext:value-type="error">
      <table:p>#VALUE!</table:p>
     </text:table-cell>
    </text:table-row>
    <text:table-row text:style-name="ro1">
     <text:table-cell text:formula="of:=COM.MICROSOFT.CEILING(1.5;1)" office:value-type="float" office:value="2" calcext:value-type="float">
      <table:p>2</table:p>
     </text:table-cell>
     <text:table-cell text:formula="of:=SUM({1;2|3;4})" office:value-type="float" office:value="10" calcext:value-type="float">
      <table:p>10</table:p>
     </text:table-cell>
     <text:table-cell text:formula="of:=answer+1" office:value-type="float" office:value="43" calcext:value-type="float">
      <table:p>43</table:p>
     </text:table-cell>
     <text:table-cell text:number-columns-repeated="2"/>
    </text:table-row>
   </text:table>
   <text:named-expressions>
    <text:named-expression text:name="answer" text:base-cell-address="$Names.$A$1" text:expression="42"/>
    <text:named-expression text:name="greeting" text:base-cell-address="$Names.$A$1" text:expression="&quot;hi&quot;"/>
    <text:named-expression text:name="listnm" text:base-cell-address="$Names.$B$1" text:expression="[$Names.$B$1] [$Names.$C$2]"/>
    <text:named-range text:name="myrange" text:base-cell-address="$Table.$B$2" text:cell-range-address="$Table.$B$2:.$F$6"/>
    <text:named-range text:name="onecell" text:base-cell-address="$Names.$B$1" text:cell-range-address="$Names.$B$1"/>
   </text:named-expressions>
  </office:spreadsheet>
 </office:body>
</office:document>