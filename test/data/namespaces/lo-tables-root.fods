    <x:p>Page <x:page-number>1</x:page-number><x:s/>/ <x:page-count>99</x:page-count></x:p>
   </s:footer>
   <s:footer-left s:display="false"/>
   <s:footer-first s:display="false"/>
  </s:master-page>
 </o:master-styles>
 <o:body>
  <o:spreadsheet>
   <t:table t:name="Table" t:style-name="ta2">
    <t:table-column t:style-name="co1" t:number-columns-repeated="4" t:default-cell-style-name="Default"/>
    <t:table-column t:style-name="co1" t:default-cell-style-name="ce3"/>
    <t:table-column t:style-name="co1" t:default-cell-style-name="ce4"/>
    <t:table-column t:style-name="co1" t:number-columns-repeated="2" t:default-cell-style-name="Default"/>
    <t:table-row t:style-name="ro1">
     <t:table-cell t:number-columns-repeated="4"/>
     <t:table-cell t:style-name="Default" t:number-columns-repeated="2"/>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell/>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>id</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>name</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>value</x:p>
     </t:table-cell>
     <t:table-cell t:style-name="Default" o:value-type="string" c:value-type="string">
      <x:p>day</x:p>
     </t:table-cell>
     <t:table-cell t:style-name="Default" o:value-type="string" c:value-type="string">
      <x:p>flag</x:p>
     </t:table-cell>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell/>
     <t:table-cell o:value-type="float" o:value="1" c:value-type="float">
      <x:p>1</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>a</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="1.5" c:value-type="float">
      <x:p>1.5</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="date" o:date-value="2024-01-01" c:value-type="date">
      <x:p>2024-01-01</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="boolean" o:boolean-value="true" c:value-type="boolean">
      <x:p>TRUE</x:p>
     </t:table-cell>
     <t:table-cell/>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>note</x:p>
     </t:table-cell>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell/>
     <t:table-cell o:value-type="float" o:value="2" c:value-type="float">
      <x:p>2</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>b</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="2.5" c:value-type="float">
      <x:p>2.5</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="date" o:date-value="2024-01-02" c:value-type="date">
      <x:p>2024-01-02</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="boolean" o:boolean-value="false" c:value-type="boolean">
      <x:p>FALSE</x:p>
     </t:table-cell>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell/>
     <t:table-cell o:value-type="float" o:value="3" c:value-type="float">
      <x:p>3</x:p>
     </t:table-cell>
     <t:table-cell/>
     <t:table-cell o:value-type="float" o:value="3" c:value-type="float">
      <x:p>3</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="date" o:date-value="2024-01-03" c:value-type="date">
      <x:p>2024-01-03</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="boolean" o:boolean-value="true" c:value-type="boolean">
      <x:p>TRUE</x:p>
     </t:table-cell>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell/>
     <t:table-cell o:value-type="float" o:value="4" c:value-type="float">
      <x:p>4</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>d</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="4.25" c:value-type="float">
      <x:p>4.25</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="date" o:date-value="2024-01-04" c:value-type="date">
      <x:p>2024-01-04</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="boolean" o:boolean-value="false" c:value-type="boolean">
      <x:p>FALSE</x:p>
     </t:table-cell>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell t:number-columns-repeated="4"/>
     <t:table-cell t:style-name="Default" t:number-columns-repeated="2"/>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell/>
     <t:table-cell o:value-type="float" o:value="6" c:value-type="float">
      <x:p>6</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>f</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="6.5" c:value-type="float">
      <x:p>6.5</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="date" o:date-value="2024-01-06" c:value-type="date">
      <x:p>2024-01-06</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="boolean" o:boolean-value="true" c:value-type="boolean">
      <x:p>TRUE</x:p>
     </t:table-cell>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell/>
     <t:table-cell o:value-type="float" o:value="7" c:value-type="float">
      <x:p>7</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>g</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="7.5" c:value-type="float">
      <x:p>7.5</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="date" o:date-value="2024-01-07" c:value-type="date">
      <x:p>2024-01-07</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="boolean" o:boolean-value="false" c:value-type="boolean">
      <x:p>FALSE</x:p>
     </t:table-cell>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
   </t:table>
   <t:table t:name="Names" t:style-name="ta2">
    <t:table-column t:style-name="co1" t:number-columns-repeated="3" t:default-cell-style-name="Default"/>
    <t:table-row t:style-name="ro1">
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>n1</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="10" c:value-type="float">
      <x:p>10</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="20" c:value-type="float">
      <x:p>20</x:p>
     </t:table-cell>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>n2</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="30" c:value-type="float">
      <x:p>30</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="float" o:value="40" c:value-type="float">
      <x:p>40</x:p>
     </t:table-cell>
    </t:table-row>
    <t:named-expressions>
     <t:named-range t:name="localr" t:base-cell-address="$Names.$A$1" t:cell-range-address="$Names.$B$1:.$C$2"/>
    </t:named-expressions>
   </t:table>
   <t:table t:name="Merged" t:style-name="ta2">
    <t:table-column t:style-name="co1" t:number-columns-repeated="3" t:default-cell-style-name="Default"/>
    <t:table-row t:style-name="ro1">
     <t:table-cell o:value-type="string" c:value-type="string" t:number-columns-spanned="2" t:number-rows-spanned="2">
      <x:p>m</x:p>
     </t:table-cell>
     <t:covered-table-cell/>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>c1</x:p>
     </t:table-cell>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:covered-table-cell t:number-columns-repeated="2"/>
     <t:table-cell/>
    </t:table-row>
   </t:table>
   <t:table t:name="Hidden" t:style-name="taHidden">
    <t:table-column t:style-name="co1" t:default-cell-style-name="Default"/>
    <t:table-row t:style-name="ro1">
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>secret</x:p>
     </t:table-cell>
    </t:table-row>
   </t:table>
   <t:table t:name="My sheet" t:style-name="ta2">
    <t:table-column t:style-name="co1" t:number-columns-repeated="2" t:default-cell-style-name="Default"/>
    <t:table-row t:style-name="ro1">
     <t:table-cell o:value-type="float" o:value="5" c:value-type="float">
      <x:p>5</x:p>
     </t:table-cell>
     <t:table-cell o:value-type="string" c:value-type="string">
      <x:p>x</x:p>
     </t:table-cell>
    </t:table-row>
   </t:table>
   <t:table t:name="Formulas" t:style-name="ta2">
    <t:table-column t:style-name="co1" t:number-columns-repeated="5" t:default-cell-style-name="Default"/>
    <t:table-row t:style-name="ro1">
     <t:table-cell t:formula="of:=SUM([Table.D4:.D10])" o:value-type="float" o:value="23.75" c:value-type="float">
      <x:p>23.75</x:p>
     </t:table-cell>
     <t:table-cell t:formula="of:=[&apos;My sheet&apos;.A1]*2" o:value-type="float" o:value="10" c:value-type="float">
      <x:p>10</x:p>
     </t:table-cell>
     <t:table-cell t:formula="of:=1/0" o:value-type="string" o:string-value="" c:value-type="error">
      <x:p>#DIV/0!</x:p>
     </t:table-cell>
     <t:table-cell t:formula="of:=&quot;a&quot;&amp;&quot;b&quot;" o:value-type="string" o:string-value="ab" c:value-type="string">
      <x:p>ab</x:p>
     </t:table-cell>
     <t:table-cell t:formula="of:=myrange" o:value-type="string" o:string-value="" c:value-type="error">
      <x:p>#VALUE!</x:p>
     </t:table-cell>
    </t:table-row>
    <t:table-row t:style-name="ro1">
     <t:table-cell t:formula="of:=COM.MICROSOFT.CEILING(1.5;1)" o:value-type="float" o:value="2" c:value-type="float">
      <x:p>2</x:p>
     </t:table-cell>
     <t:table-cell t:formula="of:=SUM({1;2|3;4})" o:value-type="float" o:value="10" c:value-type="float">
      <x:p>10</x:p>
     </t:table-cell>
     <t:table-cell t:formula="of:=answer+1" o:value-type="float" o:value="43" c:value-type="float">
      <x:p>43</x:p>
     </t:table-cell>
     <t:table-cell t:number-columns-repeated="2"/>
    </t:table-row>
   </t:table>
   <t:named-expressions>
    <t:named-expression t:name="answer" t:base-cell-address="$Names.$A$1" t:expression="42"/>
    <t:named-expression t:name="greeting" t:base-cell-address="$Names.$A$1" t:expression="&quot;hi&quot;"/>
    <t:named-expression t:name="listnm" t:base-cell-address="$Names.$B$1" t:expression="[$Names.$B$1] [$Names.$C$2]"/>
    <t:named-range t:name="myrange" t:base-cell-address="$Table.$B$2" t:cell-range-address="$Table.$B$2:.$F$6"/>
    <t:named-range t:name="onecell" t:base-cell-address="$Names.$B$1" t:cell-range-address="$Names.$B$1"/>
   </t:named-expressions>
  </o:spreadsheet>
 </o:body>
</o:document>